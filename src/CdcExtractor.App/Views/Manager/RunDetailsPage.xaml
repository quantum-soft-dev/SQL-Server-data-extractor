<UserControl x:Class="CdcExtractor.App.Views.Manager.RunDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CdcExtractor.App.Controls"
             xmlns:vm="clr-namespace:CdcExtractor.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:RunDetailsViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Back Button + Title Row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Back"
                    Style="{StaticResource SecondaryButton}"
                    Click="BackButton_Click"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0" />
            <TextBlock Text="Run Details"
                       Style="{StaticResource H1}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Error Banner -->
        <Border Grid.Row="1"
                Background="#FEE2E2" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}, TargetNullValue=Collapsed, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" />
        </Border>

        <!-- Batch Header Card -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 1 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                    <TextBlock Text="Batch ID" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding BatchDetails.BatchId, FallbackValue=--}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,12">
                    <TextBlock Text="Type" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <controls:TagBadge Tag="{Binding BatchDetails.Type, FallbackValue=''}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Status" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <controls:TagBadge Tag="{Binding BatchDetails.Status, FallbackValue=''}" />
                </StackPanel>

                <!-- Row 2 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Trigger" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding BatchDetails.Trigger, FallbackValue=--}" Style="{StaticResource Body}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Started" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding BatchDetails.StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', FallbackValue=--}" Style="{StaticResource Body}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Finished" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding BatchDetails.FinishedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', FallbackValue=--}" Style="{StaticResource Body}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Duration" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Duration, FallbackValue=--}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Datasets + Errors -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Datasets Section -->
                <TextBlock Text="Datasets" Style="{StaticResource H2}" Margin="0,0,0,8" />

                <DataGrid ItemsSource="{Binding Datasets}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="1"
                          BorderBrush="{StaticResource BorderBrush}"
                          Background="{StaticResource SurfaceBrush}"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          Margin="0,0,0,24">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="*" />
                        <DataGridTextColumn Header="From LSN" Binding="{Binding FromLsn, TargetNullValue=--}" Width="120" />
                        <DataGridTextColumn Header="To LSN" Binding="{Binding ToLsn, TargetNullValue=--}" Width="120" />
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:TagBadge Tag="{Binding Status}" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Rows" Binding="{Binding RowCount, StringFormat=N0}" Width="80" />
                        <DataGridTextColumn Header="Chunks" Binding="{Binding ChunkCount}" Width="70" />
                        <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Errors Section (only visible when errors exist) -->
                <StackPanel x:Name="ErrorsSection">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Errors.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Errors" Style="{StaticResource H2}" Foreground="#DC2626" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                                        BorderBrush="#FCA5A5" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Severity + Code -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Margin="0,0,0,6">
                                            <controls:TagBadge Tag="{Binding Severity}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Code}" Style="{StaticResource Body}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock.Text>
                                                    <Binding Path="OccurredAt" StringFormat="{}{0:HH:mm:ss}" />
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Scope + Table -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Style="{StaticResource Caption}" Margin="0,0,0,4">
                                            <Run Text="Scope:" FontWeight="SemiBold" />
                                            <Run Text="{Binding Scope, Mode=OneWay}" />
                                            <Run Text="  Table:" FontWeight="SemiBold" />
                                            <Run Text="{Binding Table, TargetNullValue=N/A, Mode=OneWay}" />
                                        </TextBlock>

                                        <!-- Message -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding Message}" Style="{StaticResource Body}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
