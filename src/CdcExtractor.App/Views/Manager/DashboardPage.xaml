<UserControl x:Class="CdcExtractor.App.Views.Manager.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdcExtractor.App.ViewModels"
             xmlns:controls="clr-namespace:CdcExtractor.App.Controls"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header row with title and refresh button -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Dashboard"
                       Style="{StaticResource H1}"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center" />
            <Button Content="Refresh"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
        </DockPanel>

        <!-- Top: Service Status Card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status indicator dot + label -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Service Stopped" />
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                        <Setter Property="Text" Value="Service Running" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Uptime + PID -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Run Text="Uptime: " />
                        <Run Text="{Binding ServiceUptime, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                        <Run Text="PID: " />
                        <Run Text="{Binding ServicePid, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Middle: Two-column info cards -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: Current batch info + CDC lag -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Current Batch" Style="{StaticResource H2}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Batch ID:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentBatchId, TargetNullValue='--'}"
                                   Style="{StaticResource Body}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Type:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <controls:TagBadge Grid.Column="1"
                                           Tag="{Binding CurrentBatchType, TargetNullValue=''}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Trigger:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentBatchTrigger, TargetNullValue='--'}"
                                   Style="{StaticResource Body}" />
                    </Grid>

                    <Border BorderThickness="0,1,0,0"
                            BorderBrush="{StaticResource BorderBrush}"
                            Margin="0,8,0,0"
                            Padding="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CDC Lag:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CdcLag, StringFormat='{}{0:hh\\:mm\\:ss}'}"
                                       Style="{StaticResource Body}" FontWeight="SemiBold" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right column: Last batch summary + next scheduled run -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Schedule" Style="{StaticResource H2}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Last Duration:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastBatchDuration, StringFormat='{}{0:hh\\:mm\\:ss}', TargetNullValue='--'}"
                                   Style="{StaticResource Body}" FontWeight="SemiBold" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Next Run:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding NextScheduledRun, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', TargetNullValue='--'}"
                                   Style="{StaticResource Body}" FontWeight="SemiBold" />
                    </Grid>

                    <!-- Error message -->
                    <Border Margin="0,8,0,0" Padding="8"
                            CornerRadius="4"
                            Background="#FEE2E2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom: Recent Batches -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock Text="Recent Batches"
                           Style="{StaticResource H2}"
                           DockPanel.Dock="Top"
                           Margin="0,0,0,12" />

                <DataGrid ItemsSource="{Binding RecentBatches}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="{StaticResource SurfaceBrush}"
                          AlternatingRowBackground="{StaticResource BackgroundBrush}"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          VerticalScrollBarVisibility="Auto"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Type" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:TagBadge Tag="{Binding Type}" Margin="4,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:TagBadge Tag="{Binding Status}" Margin="4,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="90" />

                        <DataGridTextColumn Header="Started"
                                            Binding="{Binding StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                            Width="150" />

                        <DataGridTemplateColumn Header="Duration" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="In progress" />
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FinishedAt}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="In progress" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Tables" Width="80">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0}/{1}">
                                    <Binding Path="TablesSucceeded" />
                                    <Binding Path="TablesTotal" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Rows"
                                            Binding="{Binding TotalRows, StringFormat='{}{0:N0}'}"
                                            Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
