<UserControl x:Class="CdcExtractor.App.Views.Manager.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdcExtractor.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             mc:Ignorable="d">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   Style="{StaticResource H1}"
                   Margin="0,0,0,8" />

        <!-- Description -->
        <TextBlock Grid.Row="1"
                   Text="Configure the SQL Server CDC Data Extractor. Changes take effect after saving."
                   TextWrapping="Wrap"
                   Style="{StaticResource Caption}"
                   Margin="0,0,0,16" />

        <!-- Settings sections -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- SQL Server Section -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SQL Server"
                                   Style="{StaticResource H2}"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Server:" VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBox}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Instance:" VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Instance, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBox}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Database:" VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBox}" />
                        </Grid>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auth Type:" VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AuthTypes}"
                                      SelectedItem="{Binding AuthType}"
                                      Style="{StaticResource ThemedComboBox}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Downstream Section -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Downstream"
                                   Style="{StaticResource H2}"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Base URL:" VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBox}" />
                        </Grid>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Client ID:" VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBox}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Schedule Section -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Schedule"
                                   Style="{StaticResource H2}"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Timezone:" VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Timezone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBox}" />
                        </Grid>

                        <TextBlock Text="Cron Expressions:"
                                   Style="{StaticResource Body}"
                                   Margin="0,0,0,6" />

                        <ListBox ItemsSource="{Binding CronExpressions}"
                                 SelectedItem="{Binding SelectedCronExpression}"
                                 MinHeight="60"
                                 MaxHeight="150"
                                 Margin="0,0,0,8"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBox Text="{Binding NewCronExpression, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBox}"
                                     Width="260"
                                     Margin="0,0,8,0" />
                            <Button Content="Add"
                                    Command="{Binding AddCronCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6"
                                    Margin="0,0,6,0" />
                            <Button Content="Remove"
                                    Command="{Binding RemoveCronCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="12,6" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CDC Section -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CDC"
                                   Style="{StaticResource H2}"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto Enable Database:"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding AutoEnableDatabase}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto Enable Tables:"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding AutoEnableTables}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Retention Min Days:"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding RetentionMinDays, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBox}"
                                     Width="120"
                                     HorizontalAlignment="Left" />
                        </Grid>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Batch Inactivity TTL (min):"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding BatchInactivityTtlMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBox}"
                                     Width="120"
                                     HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Extraction Section -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Extraction"
                                   Style="{StaticResource H2}"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Bytes Per Chunk:"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding MaxBytesPerChunk, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBox}"
                                     Width="160"
                                     HorizontalAlignment="Left" />
                        </Grid>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Small Table Snap Threshold:"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Body}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SmallTableSnapThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBox}"
                                     Width="160"
                                     HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Save / Reload buttons and status -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,0" />
            <Button Content="Reload"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,16,0" />

            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
    </Grid>

</UserControl>
