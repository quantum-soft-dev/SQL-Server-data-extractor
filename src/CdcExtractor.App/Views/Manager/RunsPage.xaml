<UserControl x:Class="CdcExtractor.App.Views.Manager.RunsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdcExtractor.App.ViewModels"
             xmlns:controls="clr-namespace:CdcExtractor.App.Controls"
             d:DataContext="{d:DesignInstance vm:RunsViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Row -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Runs"
                       Style="{StaticResource H1}"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center" />
            <Button Content="Refresh"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding LoadBatchesCommand}"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
        </DockPanel>

        <!-- Error Banner -->
        <Border Grid.Row="1"
                Background="#FEE2E2" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}, TargetNullValue=Collapsed, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" />
        </Border>

        <!-- Batches DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Batches}"
                      SelectedItem="{Binding SelectedBatch, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      RowBackground="{StaticResource SurfaceBrush}"
                      AlternatingRowBackground="{StaticResource BackgroundBrush}"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      VerticalScrollBarVisibility="Auto"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Type" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:TagBadge Tag="{Binding Type}" Margin="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:TagBadge Tag="{Binding Status}" Margin="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="90" />

                    <DataGridTextColumn Header="Started"
                                        Binding="{Binding StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                        Width="150" />

                    <DataGridTextColumn Header="Finished"
                                        Binding="{Binding FinishedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', TargetNullValue='--'}"
                                        Width="150" />

                    <DataGridTemplateColumn Header="Duration" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Text" Value="In progress" />
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Tables" Width="80">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0}/{1}">
                                <Binding Path="TablesSucceeded" />
                                <Binding Path="TablesTotal" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Rows"
                                        Binding="{Binding TotalRows, StringFormat='{}{0:N0}'}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
