<UserControl x:Class="CdcExtractor.App.Views.Wizard.CdcPolicyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CdcExtractor.App.ViewModels.Wizard"
             d:DataContext="{d:DesignInstance vm:CdcPolicyViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="CDC Policy"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Configure Change Data Capture behavior and extraction settings."
                   FontSize="14" Foreground="#64748B" Margin="0,0,0,24" />

        <!-- Policy Fields -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                <!-- CDC Auto-Enable -->
                <TextBlock Text="CDC Automation" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                <CheckBox Content="Auto-enable CDC on database"
                          IsChecked="{Binding AutoEnableDatabase}" Margin="0,0,0,8" />

                <CheckBox Content="Auto-enable CDC on selected tables"
                          IsChecked="{Binding AutoEnableTables}" Margin="0,0,0,16" />

                <!-- Retention -->
                <TextBlock Text="Retention and Timing" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Retention (minimum days):" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding RetentionMinDays, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" />
                    <TextBlock Grid.Column="2" Text="days" Foreground="#64748B"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Batch inactivity TTL:" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding BatchInactivityTtlMinutes, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" />
                    <TextBlock Grid.Column="2" Text="minutes" Foreground="#64748B"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <!-- Extraction Settings -->
                <TextBlock Text="Extraction Settings" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Max bytes per chunk:" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding MaxBytesPerChunkMb, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" />
                    <TextBlock Grid.Column="2" Text="MB" Foreground="#64748B"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Small table snap threshold:" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SmallTableSnapThreshold, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" />
                    <TextBlock Grid.Column="2" Text="rows" Foreground="#64748B"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Navigation -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back"
                    Command="{Binding Wizard.BackCommand}"
                    Padding="24,8" FontSize="14" Margin="0,0,8,0" />
            <Button Content="Next"
                    Command="{Binding Wizard.NextCommand}"
                    Padding="24,8" FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>
