<UserControl x:Class="CdcExtractor.App.Views.Wizard.BootstrapRunPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CdcExtractor.App.ViewModels.Wizard"
             d:DataContext="{d:DesignInstance vm:BootstrapRunViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Bootstrap Run"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Run the initial snapshot extraction for selected tables."
                   FontSize="14" Foreground="#64748B" Margin="0,0,0,16" />

        <!-- Status -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Start Bootstrap"
                    Command="{Binding RunBootstrapCommand}"
                    Padding="16,6" Margin="0,0,12,0" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#64748B" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <Setter Property="Foreground" Value="#16A34A" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                <Setter Property="Foreground" Value="#DC2626" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Per-Table Progress -->
        <GroupBox Grid.Row="3" Header="Table Progress" Padding="8" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TableProgress}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding TableName}" VerticalAlignment="Center" />

                                <ProgressBar Grid.Column="1"
                                             Value="{Binding ProgressPercent}"
                                             Minimum="0" Maximum="100"
                                             Height="18" Margin="8,0" />

                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Status}" />
                                            <Setter Property="Foreground" Value="#64748B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                                    <Setter Property="Foreground" Value="#16A34A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- Live Log -->
        <GroupBox Grid.Row="4" Header="Log" Padding="8" Margin="0,0,0,16" MaxHeight="200">
            <ListBox ItemsSource="{Binding LogEntries}"
                     FontFamily="Consolas" FontSize="12"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Navigation -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back"
                    Command="{Binding Wizard.BackCommand}"
                    Padding="24,8" FontSize="14" Margin="0,0,8,0" />
            <Button Content="Next"
                    Command="{Binding Wizard.NextCommand}"
                    Padding="24,8" FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>
