<UserControl x:Class="CdcExtractor.App.Views.Wizard.DownstreamAuthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CdcExtractor.App.ViewModels.Wizard"
             d:DataContext="{d:DesignInstance vm:DownstreamAuthViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Downstream Authentication"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Configure the downstream API endpoint and authenticate using the device-code flow."
                   FontSize="14" Foreground="#64748B" Margin="0,0,0,24" />

        <!-- Auth Fields -->
        <StackPanel Grid.Row="2" MaxWidth="500" HorizontalAlignment="Left">
            <!-- Base URL -->
            <TextBlock Text="Base URL" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" Padding="6,4" />

            <!-- Client ID -->
            <TextBlock Text="Client ID" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16" Padding="6,4" />

            <!-- Authorize Button -->
            <Button Content="Authorize"
                    Command="{Binding AuthorizeCommand}"
                    Padding="16,6" Margin="0,0,0,16" HorizontalAlignment="Left" />

            <!-- User Code (visible when authorizing or authorized) -->
            <GroupBox Header="Device Authorization" Padding="12" Margin="0,0,0,12">
                <GroupBox.Style>
                    <Style TargetType="GroupBox">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAuthorizing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAuthorized}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="User Code:" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding UserCode}"
                                   FontSize="18" FontWeight="Bold" FontFamily="Consolas"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Copy"
                                Command="{Binding CopyUserCodeCommand}"
                                Padding="12,4" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Verify at:" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding VerificationUri}"
                                   Foreground="#2563EB" TextDecorations="Underline" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#64748B" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAuthorized}" Value="True">
                                <Setter Property="Foreground" Value="#16A34A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back"
                    Command="{Binding Wizard.BackCommand}"
                    Padding="24,8" FontSize="14" Margin="0,0,8,0" />
            <Button Content="Next"
                    Command="{Binding Wizard.NextCommand}"
                    Padding="24,8" FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>
