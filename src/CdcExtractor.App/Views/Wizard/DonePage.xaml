<UserControl x:Class="CdcExtractor.App.Views.Wizard.DonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CdcExtractor.App.ViewModels.Wizard"
             d:DataContext="{d:DesignInstance vm:DoneViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Setup Complete"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Your CDC data extraction pipeline is configured and running."
                   FontSize="14" Foreground="#64748B" Margin="0,0,0,24" />

        <!-- Summary -->
        <StackPanel Grid.Row="2" MaxWidth="500" HorizontalAlignment="Left">
            <GroupBox Header="Setup Summary" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SQL Server:" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding ServerSummary}" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tables Tracked:" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding TableCount}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Schedules:" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding ScheduleCount}" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Service Status" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Service Status:" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding ServiceStatus}" Foreground="#16A34A" />
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Next Scheduled Run:" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding NextScheduledRun}" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <Button Content="Open Manager"
                    Command="{Binding OpenManagerCommand}"
                    Padding="20,8" FontSize="14" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back"
                    Command="{Binding Wizard.BackCommand}"
                    Padding="24,8" FontSize="14" Margin="0,0,8,0" />
        </StackPanel>
    </Grid>
</UserControl>
