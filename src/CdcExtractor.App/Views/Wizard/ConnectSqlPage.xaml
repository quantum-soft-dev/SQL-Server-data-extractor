<UserControl x:Class="CdcExtractor.App.Views.Wizard.ConnectSqlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CdcExtractor.App.ViewModels.Wizard"
             d:DataContext="{d:DesignInstance vm:ConnectSqlViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Connect to SQL Server"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Enter the connection details for your SQL Server instance."
                   FontSize="14" Foreground="#64748B" Margin="0,0,0,24" />

        <!-- Connection Fields -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                <!-- Server -->
                <TextBlock Text="Server" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" Padding="6,4" />

                <!-- Instance -->
                <TextBlock Text="Instance (optional)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding Instance, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" Padding="6,4" />

                <!-- Database -->
                <TextBlock Text="Database" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" Padding="6,4" />

                <!-- Auth Type -->
                <TextBlock Text="Authentication" FontWeight="SemiBold" Margin="0,0,0,8" />
                <RadioButton Content="Windows Authentication" GroupName="AuthType"
                             IsChecked="{Binding UseWindowsAuth}" Margin="0,0,0,4" />
                <RadioButton Content="SQL Server Login" GroupName="AuthType"
                             x:Name="SqlLoginRadio" Margin="0,0,0,12" />

                <!-- SQL Login Fields (visible when SQL auth) -->
                <StackPanel Margin="0,0,0,12">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UseWindowsAuth}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" Padding="6,4" />

                    <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12" Padding="6,4" />
                </StackPanel>

                <!-- Encrypt -->
                <CheckBox Content="Encrypt connection" IsChecked="{Binding Encrypt}" Margin="0,0,0,16" />

                <!-- Test Connection -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Test Connection"
                            Command="{Binding TestConnectionCommand}"
                            Padding="16,6" />
                    <TextBlock Text="Testing..." Margin="12,0,0,0" VerticalAlignment="Center"
                               FontStyle="Italic" Foreground="#64748B">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Test Result -->
                <TextBlock Text="{Binding TestResultMessage}" Margin="0,0,0,8" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#64748B" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                    <Setter Property="Foreground" Value="#16A34A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestFailed}" Value="True">
                                    <Setter Property="Foreground" Value="#DC2626" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Navigation -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back"
                    Command="{Binding Wizard.BackCommand}"
                    Padding="24,8" FontSize="14" Margin="0,0,8,0" />
            <Button Content="Next"
                    Command="{Binding Wizard.NextCommand}"
                    Padding="24,8" FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>
