<UserControl x:Class="CdcExtractor.App.Views.Wizard.SelectTablesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CdcExtractor.App.ViewModels.Wizard"
             d:DataContext="{d:DesignInstance vm:SelectTablesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Select Tables"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Choose which tables to track for CDC change extraction."
                   FontSize="14" Foreground="#64748B" Margin="0,0,0,16" />

        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" />

            <Button Grid.Column="1" Content="Load Tables"
                    Command="{Binding LoadTablesCommand}"
                    Padding="12,4" Margin="8,0,0,0" />

            <Button Grid.Column="2" Content="Select All"
                    Command="{Binding SelectAllCommand}"
                    Padding="12,4" Margin="8,0,0,0" />

            <Button Grid.Column="3" Content="Deselect All"
                    Command="{Binding DeselectAllCommand}"
                    Padding="12,4" Margin="8,0,0,0" />
        </Grid>

        <!-- Table List -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding FilteredTables}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#E2E8F0">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                        Header="" Width="40" />
                <DataGridTextColumn Binding="{Binding FullName}" Header="Table Name"
                                    IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Selection Count -->
        <TextBlock Grid.Row="4" Margin="0,8,0,12">
            <Run Text="{Binding SelectedCount, Mode=OneWay}" />
            <Run Text=" table(s) selected" />
        </TextBlock>

        <!-- Navigation -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back"
                    Command="{Binding Wizard.BackCommand}"
                    Padding="24,8" FontSize="14" Margin="0,0,8,0" />
            <Button Content="Next"
                    Command="{Binding Wizard.NextCommand}"
                    Padding="24,8" FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>
