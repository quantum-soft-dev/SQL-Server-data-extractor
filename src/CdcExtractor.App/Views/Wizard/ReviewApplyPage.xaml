<UserControl x:Class="CdcExtractor.App.Views.Wizard.ReviewApplyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CdcExtractor.App.ViewModels.Wizard"
             d:DataContext="{d:DesignInstance vm:ReviewApplyViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Review and Apply"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Review your configuration before applying."
                   FontSize="14" Foreground="#64748B" Margin="0,0,0,24" />

        <!-- Config Summary -->
        <GroupBox Grid.Row="2" Header="Configuration Summary" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SQL Server:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding ServerSummary}" TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Authentication:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding AuthSummary}" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Downstream URL:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding DownstreamSummary}" TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tables Selected:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding TableCount}" />
                </Grid>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Schedules:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding ScheduleSummary}" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Apply Steps Checklist -->
        <GroupBox Grid.Row="3" Header="Apply Progress" Padding="16">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding ApplySteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Status indicator -->
                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="--" />
                                            <Setter Property="Foreground" Value="#94A3B8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="..." />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="Text" Value="OK" />
                                                    <Setter Property="Foreground" Value="#16A34A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                           TextWrapping="Wrap" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ApplyFailed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- Apply Button -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,16">
            <Button Content="Apply Configuration"
                    Command="{Binding ApplyCommand}"
                    Padding="20,8" FontSize="14" />

            <TextBlock Text="Configuration applied successfully." Foreground="#16A34A"
                       VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ApplySucceeded}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back"
                    Command="{Binding Wizard.BackCommand}"
                    Padding="24,8" FontSize="14" Margin="0,0,8,0" />
            <Button Content="Next"
                    Command="{Binding Wizard.NextCommand}"
                    Padding="24,8" FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>
