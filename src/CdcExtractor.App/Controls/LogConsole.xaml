<UserControl x:Class="CdcExtractor.App.Controls.LogConsole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CdcExtractor.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="700">

    <UserControl.Resources>
        <!-- Level badge colors -->
        <SolidColorBrush x:Key="LevelInfoBg" Color="#DCFCE7" />
        <SolidColorBrush x:Key="LevelInfoFg" Color="#16A34A" />
        <SolidColorBrush x:Key="LevelWarnBg" Color="#FEF9C3" />
        <SolidColorBrush x:Key="LevelWarnFg" Color="#CA8A04" />
        <SolidColorBrush x:Key="LevelErrorBg" Color="#FEE2E2" />
        <SolidColorBrush x:Key="LevelErrorFg" Color="#DC2626" />
        <SolidColorBrush x:Key="LevelDebugBg" Color="#F1F5F9" />
        <SolidColorBrush x:Key="LevelDebugFg" Color="#64748B" />
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,6">
                <WrapPanel VerticalAlignment="Center">
                    <!-- Severity filter -->
                    <TextBlock Text="Level:"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,4,0" />
                    <ComboBox x:Name="SeverityFilter"
                              Width="100"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              SelectionChanged="SeverityFilter_SelectionChanged">
                        <ComboBoxItem Content="ALL" />
                        <ComboBoxItem Content="DEBUG" />
                        <ComboBoxItem Content="INFO" IsSelected="True" />
                        <ComboBoxItem Content="WARN" />
                        <ComboBoxItem Content="ERROR" />
                    </ComboBox>

                    <!-- Search -->
                    <TextBox x:Name="SearchBox"
                             Width="180"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Padding="6,4"
                             Margin="0,0,12,0"
                             TextChanged="SearchBox_TextChanged" />

                    <!-- Auto-scroll toggle -->
                    <ToggleButton x:Name="AutoScrollToggle"
                                  Content="Auto-scroll"
                                  IsChecked="{Binding IsAutoScrollEnabled, RelativeSource={RelativeSource AncestorType=controls:LogConsole}, Mode=TwoWay}"
                                  FontSize="11"
                                  Padding="8,3"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />

                    <!-- Pause button -->
                    <Button x:Name="PauseButton"
                            Content="Pause"
                            FontSize="11"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Click="PauseButton_Click" />

                    <!-- Copy button -->
                    <Button x:Name="CopyButton"
                            Content="Copy"
                            FontSize="11"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Click="CopyButton_Click" />

                    <!-- Export button -->
                    <Button x:Name="ExportButton"
                            Content="Export"
                            FontSize="11"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Click="ExportButton_Click" />
                </WrapPanel>
            </Border>

            <!-- Log entries -->
            <ScrollViewer x:Name="LogScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Background="{StaticResource SurfaceBrush}"
                          ScrollChanged="LogScrollViewer_ScrollChanged">
                <ItemsControl x:Name="LogItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,3"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,0.5">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Timestamp -->
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                               FontSize="11"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Width="85" />

                                    <!-- Level badge -->
                                    <Border x:Name="LevelBadge"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Width="42">
                                        <TextBlock x:Name="LevelText"
                                                   Text="{Binding Level}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Message -->
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="12"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap" />
                                </StackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <!-- Information level -->
                                <DataTrigger Binding="{Binding Level}" Value="INF">
                                    <Setter TargetName="LevelBadge" Property="Background"
                                            Value="{StaticResource LevelInfoBg}" />
                                    <Setter TargetName="LevelText" Property="Foreground"
                                            Value="{StaticResource LevelInfoFg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Information">
                                    <Setter TargetName="LevelBadge" Property="Background"
                                            Value="{StaticResource LevelInfoBg}" />
                                    <Setter TargetName="LevelText" Property="Foreground"
                                            Value="{StaticResource LevelInfoFg}" />
                                </DataTrigger>

                                <!-- Warning level -->
                                <DataTrigger Binding="{Binding Level}" Value="WRN">
                                    <Setter TargetName="LevelBadge" Property="Background"
                                            Value="{StaticResource LevelWarnBg}" />
                                    <Setter TargetName="LevelText" Property="Foreground"
                                            Value="{StaticResource LevelWarnFg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter TargetName="LevelBadge" Property="Background"
                                            Value="{StaticResource LevelWarnBg}" />
                                    <Setter TargetName="LevelText" Property="Foreground"
                                            Value="{StaticResource LevelWarnFg}" />
                                </DataTrigger>

                                <!-- Error level -->
                                <DataTrigger Binding="{Binding Level}" Value="ERR">
                                    <Setter TargetName="LevelBadge" Property="Background"
                                            Value="{StaticResource LevelErrorBg}" />
                                    <Setter TargetName="LevelText" Property="Foreground"
                                            Value="{StaticResource LevelErrorFg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter TargetName="LevelBadge" Property="Background"
                                            Value="{StaticResource LevelErrorBg}" />
                                    <Setter TargetName="LevelText" Property="Foreground"
                                            Value="{StaticResource LevelErrorFg}" />
                                </DataTrigger>

                                <!-- Debug level -->
                                <DataTrigger Binding="{Binding Level}" Value="DBG">
                                    <Setter TargetName="LevelBadge" Property="Background"
                                            Value="{StaticResource LevelDebugBg}" />
                                    <Setter TargetName="LevelText" Property="Foreground"
                                            Value="{StaticResource LevelDebugFg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Debug">
                                    <Setter TargetName="LevelBadge" Property="Background"
                                            Value="{StaticResource LevelDebugBg}" />
                                    <Setter TargetName="LevelText" Property="Foreground"
                                            Value="{StaticResource LevelDebugFg}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>

</UserControl>
