<UserControl x:Class="CdcExtractor.App.Controls.ProgressRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CdcExtractor.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="36" d:DesignWidth="500">

    <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Table name -->
        <TextBlock Grid.Column="0"
                   Text="{Binding TableName, RelativeSource={RelativeSource AncestorType=controls:ProgressRow}}"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   TextTrimming="CharacterEllipsis" />

        <!-- Progress bar -->
        <Border Grid.Column="1"
                CornerRadius="4"
                Background="{StaticResource PrimaryLightBrush}"
                Height="8"
                VerticalAlignment="Center"
                Margin="12,0">
            <Border x:Name="ProgressFill"
                    CornerRadius="4"
                    Background="{StaticResource PrimaryBrush}"
                    HorizontalAlignment="Left" />
        </Border>

        <!-- Percentage -->
        <TextBlock Grid.Column="2"
                   Text="{Binding PercentageText, RelativeSource={RelativeSource AncestorType=controls:ProgressRow}}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <!-- Status chip -->
        <controls:StatusChip Grid.Column="3"
                             Status="{Binding Status, RelativeSource={RelativeSource AncestorType=controls:ProgressRow}}"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0" />
    </Grid>

</UserControl>
