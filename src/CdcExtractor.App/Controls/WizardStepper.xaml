<UserControl x:Class="CdcExtractor.App.Controls.WizardStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="800">

    <ItemsControl x:Name="StepsItemsControl">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel HorizontalAlignment="Center" Margin="4,0">
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,4">
                        <!-- Connector line (left) -->
                        <Line X1="0" Y1="14" X2="20" Y2="14"
                              Stroke="{StaticResource BorderBrush}"
                              StrokeThickness="2"
                              HorizontalAlignment="Left"
                              Visibility="{Binding LeftLineVisibility}" />

                        <!-- Step circle -->
                        <Border Width="28" Height="28"
                                CornerRadius="14"
                                Background="{Binding CircleBackground}"
                                BorderBrush="{Binding CircleBorder}"
                                BorderThickness="2"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Display}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding CircleForeground}" />
                        </Border>

                        <!-- Connector line (right) -->
                        <Line X1="0" Y1="14" X2="20" Y2="14"
                              Stroke="{StaticResource BorderBrush}"
                              StrokeThickness="2"
                              HorizontalAlignment="Right"
                              Visibility="{Binding RightLineVisibility}" />
                    </Grid>

                    <TextBlock Text="{Binding Label}"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{Binding LabelForeground}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="90" />
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
